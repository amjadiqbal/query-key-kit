{
  "name": "@amjadiqbal/query-key-kit",
  "version": "0.1.2",
  "description": "Typed query-key hierarchy and invalidation helpers for TanStack Query v5, built on queryOptions(). A maintained successor to @lukemorales/query-key-factory with the same API. Framework-agnostic (query-core only).",
  "keywords": [
    "tanstack",
    "tanstack-query",
    "react-query",
    "vue-query",
    "solid-query",
    "svelte-query",
    "query-keys",
    "query-key-factory",
    "query-options",
    "cache-invalidation",
    "typescript"
  ],
  "homepage": "https://github.com/amjadiqbal/query-key-kit#readme",
  "bugs": "https://github.com/amjadiqbal/query-key-kit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amjadiqbal/query-key-kit.git"
  },
  "license": "MIT",
  "author": {
    "name": "Amjad Iqbal",
    "url": "https://amjad.com.pk"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.min.json && tsc -p tsconfig.dts.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --typecheck",
    "typecheck:ts5": "npm exec --yes --package=typescript@5.0.4 -- tsc -p tsconfig.ts5.json",
    "check:example": "bash scripts/check-example.sh"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tanstack/query-core": "5.104.5",
    "@tanstack/query-core-min": "npm:@tanstack/query-core@5.0.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/vue-query": "5.104.5",
    "@types/react": "19.3.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "vue": "3.5.44"
  }
}
